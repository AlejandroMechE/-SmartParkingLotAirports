{
  "terminalId": "AGU-T1",
  "laneId": "lane-entry-01",
  "laneType": "ENTRY",
  "backendUrl": "https://api.airportparking.aero/api/v1",
  "iotHubHost": "airport-parking-hub.azure-devices.net",
  "tls": {
    "certPath": "./certs/device.crt",
    "keyPath": "./certs/device.key",
    "caPath": "./certs/ca.pem"
  },
  "camera": {
    "rtspUrl": "rtsp://admin:pass@192.168.1.50:554/stream1",
    "fps": 25,
    "burstFrames": 5
  },
  "yolo": {
    "modelPath": "./models/yolov8n-plate.onnx",
    "confidenceThreshold": 0.85
  },
  "ocr": {
    "cloudTimeoutMs": 800,
    "minConfidence": 0.90
  },
  "offline": {
    "sqliteDbPath": "./data/offline_events.db",
    "cacheTtlMinutes": 15
  }
}
